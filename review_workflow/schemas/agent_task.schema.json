{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/review_workflow/agent_task.schema.json",
  "title": "Isolated single-paper AI reader task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "job_id",
    "paper_id",
    "pdf_path",
    "pdf_sha256",
    "allowed_skills",
    "read_only_sources",
    "exclusive_output_dir",
    "write_policy",
    "forbidden_writes",
    "paper_limit"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "batch_id": { "type": "string", "pattern": "^batch-[0-9a-f]{12}$" },
    "job_id": { "type": "string", "pattern": "^paper-[0-9a-f]{16}$" },
    "paper_id": { "type": "string", "pattern": "^[^\\s;,|]+$" },
    "zotero_key": { "type": "string" },
    "pdf_path": { "type": "string" },
    "pdf_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "allowed_skills": { "type": "array", "items": { "type": "string" } },
    "read_only_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "type": "string" }
    },
    "exclusive_output_dir": { "type": "string" },
    "temporary_output_dir": { "type": "string" },
    "reader_policy": { "type": "object" },
    "worker_protocol": { "type": "object" },
    "write_policy": { "const": "exclusive_output_only" },
    "forbidden_writes": { "type": "array", "items": { "type": "string" } },
    "paper_limit": { "const": 1 }
  }
}
